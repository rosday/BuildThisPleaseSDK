      "comment": "Compact progress text shown while user-written content is being translated automatically."
    },
    "User-written content is translated automatically. Use Show original to see the original text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم ترجمة المحتوى الذي يكتبه المستخدم تلقائيًا. استخدم «عرض النص الأصلي» لرؤية النص الأصلي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah napsaný uživateli se překládá automaticky. Původní text zobrazíte klepnutím na „Zobrazit originál“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerskrevet indhold oversættes automatisk. Brug “Vis original” for at se den oprindelige tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Benutzern verfasste Inhalte werden automatisch übersetzt. Tippe auf „Original anzeigen“, um den Originaltext zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο που γράφουν οι χρήστες μεταφράζεται αυτόματα. Χρησιμοποιήστε την «Προβολή πρωτοτύπου» για να δείτε το αρχικό κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-written content is translated automatically. Use Show original to see the original text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido escrito por los usuarios se traduce automáticamente. Usa «Mostrar original» para ver el texto original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjien kirjoittama sisältö käännetään automaattisesti. Näet alkuperäisen tekstin valitsemalla ”Näytä alkuperäinen”."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong isinasalin ang content na isinulat ng mga user. Gamitin ang “Ipakita ang orihinal” para makita ang orihinal na teksto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu rédigé par les utilisateurs est traduit automatiquement. Touchez « Afficher l’original » pour voir le texte d’origine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכן שנכתב על ידי משתמשים מתורגם באופן אוטומטי. אפשר לבחור „הצגת המקור” כדי לראות את הטקסט המקורי."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadržaj koji su napisali korisnici automatski se prevodi. Dodirnite „Prikaži izvornik” da biste vidjeli izvorni tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználók által írt tartalmak fordítása automatikus. Az eredeti szöveg megtekintéséhez válaszd az „Eredeti megjelenítése” lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten yang ditulis pengguna diterjemahkan secara otomatis. Gunakan “Tampilkan aslinya” untuk melihat teks asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contenuti scritti dagli utenti vengono tradotti automaticamente. Tocca “Mostra originale” per visualizzare il testo originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが作成したコンテンツは自動的に翻訳されます。元の文章を表示するには、「原文を表示」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 작성한 콘텐츠는 자동으로 번역됩니다. 원문을 보려면 ‘원문 보기’를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan yang ditulis pengguna diterjemahkan secara automatik. Gunakan “Tunjukkan teks asal” untuk melihat teks asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innhold skrevet av brukere oversettes automatisk. Trykk på «Vis original» for å se originalteksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door gebruikers geschreven inhoud wordt automatisch vertaald. Tik op ‘Origineel tonen’ om de oorspronkelijke tekst te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treści napisane przez użytkowników są tłumaczone automatycznie. Wybierz „Pokaż oryginał”, aby zobaczyć oryginalny tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo escrito por usuários é traduzido automaticamente. Toque em “Mostrar original” para ver o texto original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo escrito pelos utilizadores é traduzido automaticamente. Toque em «Mostrar original» para ver o texto original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul scris de utilizatori este tradus automat. Folosește „Afișează originalul” pentru a vedea textul original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контент, написанный пользователями, переводится автоматически. Нажмите «Показать оригинал», чтобы увидеть исходный текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah napísaný používateľmi sa prekladá automaticky. Pôvodný text zobrazíte klepnutím na „Zobraziť originál“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innehåll som skrivits av användare översätts automatiskt. Tryck på ”Visa original” för att se originaltexten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาที่ผู้ใช้เขียนจะได้รับการแปลโดยอัตโนมัติ แตะ “แสดงต้นฉบับ” เพื่อดูข้อความต้นฉบับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcıların yazdığı içerikler otomatik olarak çevrilir. Özgün metni görmek için “Orijinali göster” seçeneğine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміст, написаний користувачами, перекладається автоматично. Натисніть «Показати оригінал», щоб побачити початковий текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung do người dùng viết được dịch tự động. Chạm vào “Hiển thị bản gốc” để xem văn bản gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户编写的内容会自动翻译。轻点“显示原文”即可查看原始文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者撰寫的內容會自動翻譯。點一下「顯示原文」即可查看原始文字。"
          }
        }
      },
      "comment": "Screen-level banner explaining automatic translation of visible user-written content and the original-text control."
    },
