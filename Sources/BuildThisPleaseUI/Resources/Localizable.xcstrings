    "Implemented requests and release notes will appear here without vote totals.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الطلبات التي تم تنفيذها وملاحظات الإصدار، بدون إجمالي الأصوات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizované požadavky a poznámky k vydání se zde zobrazí bez počtu hlasů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemførte ønsker og udgivelsesnoter vises her uden stemmetal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgesetzte Wünsche und Versionshinweise werden hier ohne Stimmenzahl angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υλοποιημένα αιτήματα και οι σημειώσεις έκδοσης θα εμφανίζονται εδώ χωρίς τον αριθμό των ψήφων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implemented requests and release notes will appear here without vote totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes implementadas y las notas de la versión aparecerán aquí sin mostrar el total de votos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toteutetut pyynnöt ja julkaisutiedot näkyvät täällä ilman äänimääriä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga ipinatupad na kahilingan at mga tala sa paglabas nang hindi ipinapakita ang bilang ng mga boto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes réalisées et les notes de version apparaîtront ici sans afficher le nombre de votes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות שיושמו והערות גרסה יופיעו כאן ללא מספר ההצבעות."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se prikazati implementirani zahtjevi i napomene o izdanju, bez ukupnog broja glasova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megvalósított kérések és a kiadási megjegyzések itt jelennek meg, a szavazatok száma nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang telah diterapkan dan catatan rilis akan muncul di sini tanpa menampilkan jumlah suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste implementate e le note di rilascio verranno visualizzate qui senza mostrare il numero di voti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実装済みのリクエストとリリースノートが、投票数を表示せずにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구현된 요청과 릴리스 노트가 투표 수 없이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang telah dilaksanakan dan nota keluaran akan dipaparkan di sini tanpa menunjukkan jumlah undian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomførte ønsker og versjonsmerknader vises her uten stemmetall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïmplementeerde verzoeken en release-opmerkingen verschijnen hier zonder het aantal stemmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się wdrożone zgłoszenia i informacje o wersji, bez liczby głosów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações implementadas e notas de lançamento aparecerão aqui sem mostrar o total de votos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos implementados e as notas de lançamento aparecerão aqui sem mostrar o total de votos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitările implementate și notele de lansare vor apărea aici fără numărul de voturi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реализованные запросы и примечания к выпуску появятся здесь без количества голосов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizované požiadavky a poznámky k vydaniu sa tu zobrazia bez počtu hlasov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genomförda önskemål och versionsinformation visas här utan röstetal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอที่พัฒนาแล้วและบันทึกประจำรุ่นจะปรากฏที่นี่โดยไม่แสดงจำนวนโหวต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulanan istekler ve sürüm notları, oy sayıları gösterilmeden burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реалізовані запити та примітки до випуску відображатимуться тут без кількості голосів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu đã triển khai và ghi chú phát hành sẽ xuất hiện ở đây mà không hiển thị số phiếu bầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已实现的建议和版本说明会显示在这里，但不显示投票数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已實現的建議和版本說明會顯示在這裡，但不顯示投票數。"
          }
        }
      },
      "comment": "Empty-state explanation for the Implemented tab. These requests have shipped; translate implemented consistently with the tab title."
    },
