    "Requests submitted from this installation appear here, including pending requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الطلبات المقدمة من هذا التثبيت هنا، بما في ذلك الطلبات المعلقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí požadavky odeslané z této instalace, včetně čekajících požadavků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ønsker indsendt fra denne installation vises her, inklusive afventende ønsker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dieser Installation eingereichte Wünsche werden hier angezeigt, einschließlich noch nicht freigegebener Wünsche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αιτήματα που υποβάλλονται από αυτήν την εγκατάσταση εμφανίζονται εδώ, συμπεριλαμβανομένων των αιτημάτων που εκκρεμούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests submitted from this installation appear here, including pending requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes enviadas desde esta instalación aparecen aquí, incluidas las solicitudes pendientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä asennuksesta lähetetyt pyynnöt näkyvät tässä, mukaan lukien odottavat pyynnöt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga kahilingang isinumite mula sa pag-install na ito ay lalabas dito, kasama ang mga nakabinbing kahilingan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes soumises à partir de cette installation apparaissent ici, y compris les demandes en attente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות שנשלחו מהתקנה זו מופיעות כאן, כולל בקשות ממתינות."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjevi poslani iz ove instalacije pojavljuju se ovdje, uključujući zahtjeve na čekanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg az ebből a telepítésből beküldött kérések, beleértve a függőben lévő kéréseket is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang dikirimkan dari instalasi ini muncul di sini, termasuk permintaan yang tertunda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste inviate da questa installazione vengono visualizzate qui, comprese le richieste in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールから送信されたリクエストは、保留中のリクエストも含めてここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 중인 요청을 포함하여 이 설치에서 제출된 요청이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang dihantar daripada pemasangan ini dipaparkan di sini, termasuk permintaan yang menunggu semakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ønsker sendt inn fra denne installasjonen vises her, inkludert ventende ønsker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken die vanuit deze installatie zijn ingediend, worden hier weergegeven, inclusief openstaande verzoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się zgłoszenia wysłane z tej instalacji, w tym zgłoszenia oczekujące."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações enviadas a partir desta instalação aparecem aqui, incluindo as solicitações pendentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos enviados a partir desta instalação aparecem aqui, incluindo os pedidos pendentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitările trimise de la această instalare apar aici, inclusiv solicitările în așteptare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются запросы, отправленные из этой установки, включая ожидающие запросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia požiadavky odoslané z tejto inštalácie vrátane čakajúcich požiadaviek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Önskemål som skickats in från den här installationen visas här, inklusive väntande önskemål."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอที่ส่งจากการติดตั้งนี้จะปรากฏที่นี่ รวมถึงคำขอที่รอดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumdan gönderilen istekler, bekleyen istekler de dahil olmak üzere burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут відображаються запити, надіслані з цієї інсталяції, включно з запитами, що очікують на розгляд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu được gửi từ quá trình cài đặt này sẽ xuất hiện ở đây, bao gồm cả các yêu cầu đang chờ xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处会显示从本次安装提交的建议，包括待审核的建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處會顯示從本次安裝提交的建議，包括待審核的建議。"
          }
        }
      },
      "comment": "Empty-state explanation for the current installation's request list."
    },
    "Requests under review, planned, or being built will appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الطلبات قيد المراجعة أو المخطط لها أو قيد التطوير."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí požadavky, které se posuzují, jsou naplánované nebo ve vývoji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ønsker, der er til gennemgang, planlagt eller under udvikling, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Wünsche angezeigt, die derzeit geprüft, geplant oder umgesetzt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αιτήματα που εξετάζονται, έχουν προγραμματιστεί ή βρίσκονται υπό ανάπτυξη θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests under review, planned, or being built will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes en revisión, planificadas o en desarrollo aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkasteltavana olevat, suunnitellut tai kehitteillä olevat pyynnöt näkyvät täällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga kahilingang sinusuri, pinaplano, o ginagawa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes en cours d’examen, planifiées ou en développement apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות שנבדקות, מתוכננות או נמצאות בפיתוח יופיעו כאן."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se pojaviti zahtjevi koji se pregledavaju, planiraju ili razvijaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg az ellenőrzés alatt álló, tervezett vagy fejlesztés alatt lévő kérések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang sedang ditinjau, direncanakan, atau dikembangkan akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste in fase di revisione, pianificate o in sviluppo verranno visualizzate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュー中、計画済み、または開発中のリクエストがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 중이거나 계획되었거나 개발 중인 요청이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang sedang disemak, dirancang atau dibangunkan akan dipaparkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ønsker som vurderes, er planlagt eller under utvikling, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken die worden beoordeeld, gepland of in uitvoering zijn, worden hier weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się zgłoszenia weryfikowane, zaplanowane lub w trakcie realizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações em análise, planejadas ou em desenvolvimento aparecerão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos em análise, planeados ou em desenvolvimento aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitările în curs de analiză, planificate sau în dezvoltare vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь будут отображаться запросы на рассмотрении, запланированные или находящиеся в разработке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia požiadavky, ktoré sa posudzujú, sú naplánované alebo vo vývoji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Önskemål som granskas, planeras eller utvecklas visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอที่อยู่ระหว่างตรวจสอบ วางแผน หรือกำลังพัฒนาจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenen, planlanan veya geliştirilmekte olan istekler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут відображатимуться запити, які розглядаються, заплановані або перебувають у розробці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu đang được xem xét, đã lên kế hoạch hoặc đang phát triển sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核中、已计划或开发中的建议会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審核中、已規劃或開發中的建議會顯示在這裡。"
          }
        }
      },
      "comment": "Empty-state explanation for the public request list."
    },
