// Safe example values. Copy to a gitignored local xcconfig before using a live Worker.
PRODUCT_BUNDLE_IDENTIFIER = com.buildthisplease.example
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Build This Please
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
TARGETED_DEVICE_FAMILY = 1,2
ONLY_ACTIVE_ARCH = YES

// Supply these through a gitignored local xcconfig for physical-device staging/TestFlight.
INFOPLIST_KEY_BTPStagingBaseURL =
INFOPLIST_KEY_BTPStagingProjectKey =
INFOPLIST_KEY_BTPProductionBaseURL =
INFOPLIST_KEY_BTPProductionProjectKey =
